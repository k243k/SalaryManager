{
  "name": "nikkyu-keisan",
  "version": "1.3.0",
  "description": "時給計算アプリ - 個人用勤務管理ツール",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"webpack --watch --mode development\" \"electron .\"",
    "build": "webpack --mode production",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "electron",
    "timecard",
    "wage-calculator"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "date-fns": "^3.0.0",
    "electron-updater": "^6.6.2",
    "firebase": "^12.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.nikkyu-keisan.app",
    "productName": "時給計算アプリ",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "Docs/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "k243k",
      "repo": "SalaryManager"
    }
  }
}
